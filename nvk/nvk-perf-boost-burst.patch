+/* How long one lease lasts, and how often the renewal timer extends it while a client keeps working. The lease
+ * outlives several renewal intervals, so it does not lapse while work flows; a process that stops submitting falls
+ * out of boost within NVKMD_NVRM_BOOST_LEASE_S seconds and the GPU can drop to its idle state. The lease used to
+ * be 3 s renewed once a second from inside the submit path: every renewal was a GSP round trip under the caller's
+ * submit lock, and a pause of one second between submits dropped the clocks mid-session. */
+#define NVKMD_NVRM_BOOST_LEASE_S   30
+#define NVKMD_NVRM_BOOST_RENEW_S   5
+
+/* Renews the lease from its own thread, so the submit path never carries the GSP round trip. Wakes four times a
+ * second; a wake that finds the lease current costs one clock read. It leaves when the mode is no longer BURST, and
+ * nvkmd_nvrm_pdev_destroy joins it, so it cannot outlive the device it renews for. */
+static int
+nvkmd_nvrm_boost_thread(void *arg)
+{
+   struct nvkmd_nvrm_pdev *pdev = arg;
+   while (atomic_load_explicit(&pdev->boostMode, memory_order_relaxed) == NVKMD_NVRM_BOOST_BURST) {
+      nvkmd_nvrm_boost_refresh(pdev);
+      struct timespec ts = { .tv_sec = 0, .tv_nsec = 250 * 1000 * 1000 };
+      thrd_sleep(&ts, NULL);
+   }
+   return 0;
+}
+
+/* One renewal if the lease is due. Runs on the renewal timer and, as a fallback for a device whose timer has not
+ * started, on the submitting thread; the CAS makes concurrent callers agree on one winner. boostInFlight covers the
+ * window from the mode check to the nvRmApiControl return, so destroy can wait for a refresh to finish before it
+ * frees the subdevice the refresh talks to. */
+void
+nvkmd_nvrm_boost_refresh(struct nvkmd_nvrm_pdev *pdev)
+{
+   if (atomic_load_explicit(&pdev->boostMode, memory_order_relaxed) != NVKMD_NVRM_BOOST_BURST)
+      return;
+
+   const uint64_t now = os_time_get_nano();
+   uint64_t due = atomic_load_explicit(&pdev->boostRenewNs, memory_order_relaxed);
+   if (now < due)
+      return;
+   atomic_fetch_add_explicit(&pdev->boostInFlight, 1, memory_order_acquire);
+   /* One thread wins the renewal; the others see the new deadline and go on. */
+   if (!atomic_compare_exchange_strong_explicit(&pdev->boostRenewNs, &due, now + NVKMD_NVRM_BOOST_RENEW_S * 1000000000ull,
+                                                memory_order_relaxed, memory_order_relaxed)) {
+      atomic_fetch_sub_explicit(&pdev->boostInFlight, 1, memory_order_release);
+      return;
+   }
+
+   struct NvRmApi rm;
+   nvkmd_nvrm_dev_api_ctl(pdev, &rm);
+   NV2080_CTRL_PERF_BOOST_PARAMS bp = {
+      .flags = NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_TO_MAX,
+      .duration = NVKMD_NVRM_BOOST_LEASE_S,
+   };
+   NV_STATUS bs = nvRmApiControl(&rm, pdev->hSubdevice, NV2080_CTRL_CMD_PERF_BOOST, &bp, sizeof bp);
+   atomic_fetch_sub_explicit(&pdev->boostInFlight, 1, memory_order_release);
+   if (bs != NV_OK) {
+      /* Not supported here: stop asking rather than fail on every renewal. */
+      atomic_store_explicit(&pdev->boostMode, NVKMD_NVRM_BOOST_OFF, memory_order_relaxed);
+      if (nvkmd_nvrm_diag_on())
+         fprintf(stderr, "nvrm: PERF_BOOST lease refused (rc 0x%x), not asking again\n", (unsigned)bs);
+   }
+}
+
+/* The submit-path entry: the timer has normally renewed already, so this is a clock read and a return. */
+void
+nvkmd_nvrm_boost_burst(struct nvkmd_nvrm_pdev *pdev)
+{
+   nvkmd_nvrm_boost_refresh(pdev);
+}
