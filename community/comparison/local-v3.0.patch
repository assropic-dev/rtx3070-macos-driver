index 0000000000000000000000000000000000000000..3fafe6733345082595abf4f566bc919ae811bb24
--- /dev/null
+++ b/vendor/nvenc/src/dec_copy.c
@@ -0,0 +1,185 @@
+#include "dec_copy.h"
+#include "blocklinear.h"
+#include "nv_floor.h"
+#include <stdlib.h>
+#include "class/clc6b5.h"
+#include "class/clc7b5.h"
+#include "class/clc6b5sw.h"
+#include "class/clc56f.h"
+#include "class/cl2080_notification.h"
+#include "ctrl/ctrl2080/ctrl2080gpu.h"
+#include "ctrl/ctrl2080/ctrl2080ce.h"
+#include <string.h>
+
+static NvU32 copy_engine(Rm *rm)
+{
+    NV2080_CTRL_GPU_GET_ENGINES_V2_PARAMS list = {0};
+    if (rm_ctrl(rm, rm->subdevice, NV2080_CTRL_CMD_GPU_GET_ENGINES_V2, &list, sizeof list)) return 0;
+    for (unsigned i = 0; i < list.engineCount && i < NV2080_GPU_MAX_ENGINES_LIST_SIZE; i++) {
+        NvU32 eng = list.engineList[i];
+        if (!NV2080_ENGINE_TYPE_IS_COPY(eng)) continue;
+        NV2080_CTRL_CE_GET_CAPS_V2_PARAMS caps = { .ceEngineType = eng };
+        if (!rm_ctrl(rm, rm->subdevice, NV2080_CTRL_CMD_CE_GET_CAPS_V2, &caps, sizeof caps) &&
+            !NV2080_CTRL_CE_GET_CAP(caps.capsTbl, NV2080_CTRL_CE_CAPS_CE_GRCE)) return eng;
+    }
+    return 0;
+}
+
+bool dec_copy_open(DecCopy *copy, Rm *rm, size_t pitch, size_t rows)
+{
+    memset(copy, 0, sizeof *copy);
+    if (!pitch || !rows || pitch > 32768 || rows > 16384 || (pitch & 63) ||
+        rm_class(rm, RM_CLS_NVDEC) != 0xc7b0) return false;
+    NvU32 engine = copy_engine(rm);
+    if (!engine) return false;
+    NVC6B5_ALLOCATION_PARAMETERS params = { .version = NVC6B5_ALLOCATION_PARAMETERS_VERSION_1, .engineType = engine };
+    if (chan_create(rm, &copy->chan, engine, AMPERE_DMA_COPY_B, &params) ||
+        rm_mem_alloc(rm, &copy->scratch, pitch * ((rows + 15) / 16), 4096, false, false, true) ||
+        rm_mem_alloc(rm, &copy->sem, 4096, 4096, true, true, true) ||
+        rm_mem_alloc(rm, &copy->zero, 4096, 4096, false, true, true) ||
+        rm_mem_alloc(rm, &copy->prefix, 4096, 4096, true, true, true)) {
+        dec_copy_close(copy);
+        return false;
+    }
+    memset(copy->zero.cpu, 0, 4096);
+    *(volatile NvU32 *)copy->sem.cpu = 0;
+    return true;
+}
+
+void dec_copy_close(DecCopy *copy)
+{
+    Rm *rm = copy->chan.rm;
+    if (!rm) return;
+    for (unsigned i = 0; i < 8; i++)
+        if (copy->header[i].bytes) CFRelease(copy->header[i].bytes);
+    chan_destroy(&copy->chan);   // stop any faulted or timed-out commands before releasing their memory
+    rm_mem_free(rm, &copy->scratch);
+    rm_mem_free(rm, &copy->sem);
+    rm_mem_free(rm, &copy->zero);
+    rm_mem_free(rm, &copy->prefix);
+    rm_mem_free(rm, &copy->readback);
+    memset(copy, 0, sizeof *copy);
+}
+
+// The new producer and consumer path is enabled together. Older NVAccel versions
+// cannot publish both planes of one decode atomically.
+static bool video_planes_available(void)
+{
+    const char *enabled = getenv("NVMTL_NVDEC_VRAM");
+    if (!enabled || strcmp(enabled, "1")) return false;
+    io_service_t service = IOServiceGetMatchingService(NV_IO_MAIN_PORT, IOServiceMatching("NVAccel"));
+    if (!service) return false;
+    CFTypeRef prop = IORegistryEntryCreateCFProperty(service, CFSTR("NVAccelVideoPlanes"), NULL, 0);
+    IOObjectRelease(service);
+    int version = 0;
+    if (prop && CFGetTypeID(prop) == CFNumberGetTypeID())
+        CFNumberGetValue((CFNumberRef)prop, kCFNumberIntType, &version);
+    if (prop) CFRelease(prop);
+    return version == 1;
+}
+
+bool dec_picture_surfaces(DecCopy *copy, Rm *rm, size_t pitch, size_t rows,
+                          RmMem *y, size_t ybytes, RmMem *uv, size_t uvbytes,
+                          size_t count, bool zero)
+{
+    bool vram = video_planes_available() && dec_copy_open(copy, rm, pitch, rows);
+    for (;;) {
+        for (size_t i = 0; i < count; i++) {
+            if (rm_mem_alloc(rm, &y[i], ybytes, 4096, !vram, true, true) ||
+                rm_mem_alloc(rm, &uv[i], uvbytes, 4096, !vram, true, true)) {
+                for (size_t j = 0; j <= i; j++) {
+                    rm_mem_free(rm, &y[j]); rm_mem_free(rm, &uv[j]);
+                }
+                if (!vram) return false;
+                dec_copy_close(copy); vram = false;
+                break;
+            }
+            if (zero) { memset(y[i].cpu, 0, y[i].size); memset(uv[i].cpu, 0, uv[i].size); }
+            if (i + 1 == count) return true;
+        }
+    }
+}
+
+static void copy_rows(Chan *c, NvU64 src, NvU64 dst, NvU32 srcPitch, NvU32 dstPitch,
+                      NvU32 width, NvU32 rows, bool release)
+{
+    const NvU32 launch = DRF_DEF(C6B5, _LAUNCH_DMA, _DATA_TRANSFER_TYPE, _NON_PIPELINED) |
+        DRF_DEF(C6B5, _LAUNCH_DMA, _SRC_MEMORY_LAYOUT, _PITCH) |
+        DRF_DEF(C6B5, _LAUNCH_DMA, _DST_MEMORY_LAYOUT, _PITCH) |
+        DRF_DEF(C6B5, _LAUNCH_DMA, _MULTI_LINE_ENABLE, _TRUE);
+    chan_mthd(c, 0, NVC6B5_OFFSET_IN_UPPER, 8, (NvU32)(src >> 32), (NvU32)src,
+              (NvU32)(dst >> 32), (NvU32)dst, srcPitch, dstPitch, width, rows);
+    const NvU32 fence = DRF_DEF(C6B5, _LAUNCH_DMA, _FLUSH_ENABLE, _TRUE) |
+                        DRF_DEF(C6B5, _LAUNCH_DMA, _SEMAPHORE_TYPE, _RELEASE_ONE_WORD_SEMAPHORE);
+    chan_mthd(c, 0, NVC6B5_LAUNCH_DMA, 1, launch | (release ? fence : 0));
+}
+
+static void copy_linear(Chan *c, NvU64 src, NvU64 dst, size_t n, bool release)
+{
+    size_t blocks = n / 4096, tail = n % 4096;
+    if (blocks) copy_rows(c, src, dst, 4096, 4096, 4096, (NvU32)blocks, release && !tail);
+    if (tail) copy_rows(c, src + blocks * 4096, dst + blocks * 4096, 4096, 4096, (NvU32)tail, 1, release);
+}
+
+static bool plane_fits(const DecCopyPlane *p, size_t pitch, NvU64 destSize, NvU64 scratchSize)
+{
+    if (!p->src || !p->src->gpu || !p->bytes || !p->rows || p->rows > 16384 || p->bytes > pitch ||
+        p->stride < p->bytes || p->stride > UINT32_MAX / 16 || p->offset > destSize || p->bytes > destSize - p->offset)
+        return false;
+    size_t bands = (p->rows + 15) / 16;
+    return (p->rows - 1) <= (destSize - p->offset - p->bytes) / p->stride &&
+           bands * pitch <= scratchSize && bands * pitch * 16 <= p->src->size;
+}
+
+bool dec_copy_picture(DecCopy *copy, size_t pitch, const DecCopyPlane planes[2], const RmMem *dst,
+                      size_t frameSize, size_t prefixSize, const RmMem *mirror)
+{
+    Chan *c = &copy->chan;
+    if (!c->rm || !dst->gpu || !pitch || pitch > 32768 || (pitch & 63) ||
+        !plane_fits(&planes[0], pitch, dst->size, copy->scratch.size) ||
+        !plane_fits(&planes[1], pitch, dst->size, copy->scratch.size) || !chan_rewind(c)) return false;
+    if (frameSize > UINT32_MAX || frameSize > dst->size || prefixSize > 4096 || prefixSize > frameSize ||
+        (mirror && (!mirror->gpu || !frameSize || mirror->size < frameSize))) return false;
+    chan_mthd(c, 0, NVC56F_SET_OBJECT, 1, (NvU32)AMPERE_DMA_COPY_B);
+    const NvU32 seq = ++copy->seq;
+    chan_mthd(c, 0, NVC6B5_SET_SEMAPHORE_A, 3, (NvU32)(copy->sem.gpu >> 32), (NvU32)copy->sem.gpu, seq);
+    // Family page-off can expose the entire IOSurface allocation, including padding.
+    // Initialize it from one device-local zero page; only the small planar header comes from the CPU.
+    if (frameSize) {
+        size_t filled = frameSize < 4096 ? frameSize : 4096;
+        copy_linear(c, copy->zero.gpu, dst->gpu, filled, false);
+        while (filled < frameSize) {
+            size_t next = frameSize - filled < filled ? frameSize - filled : filled;
+            copy_linear(c, dst->gpu, dst->gpu + filled, next, false);
+            filled += next;
+        }
+    }
+    if (prefixSize) copy_linear(c, copy->prefix.gpu, dst->gpu, prefixSize, false);
+    for (unsigned pl = 0; pl < 2; pl++) {
+        const DecCopyPlane *p = &planes[pl];
+        size_t phases = p->rows < 16 ? p->rows : 16;
+        for (size_t row = 0; row < phases; row++) {
+            // For each row phase, gather its four 16-byte runs from every 64x16 tile into
+            // the scratch rows. The byte order is NVDEC KBL, not a generic Fermi GOB.
+            size_t bands = (p->rows + 15 - row) / 16;
+            for (unsigned x = 0; x < 64; x += 16) {
+                size_t off = nvenc_in_offset(x, row, pitch);
+                copy_rows(c, p->src->gpu + off, copy->scratch.gpu + x, 1024, 64,
+                          16, (NvU32)(bands * (pitch / 64)), false);
+            }
+            // Each scratch row is now one complete scanline. Skip the destination's
+            // padding and interleave this phase with the other fifteen scanlines.
+            copy_rows(c, copy->scratch.gpu, dst->gpu + p->offset + row * p->stride,
+                      (NvU32)pitch, (NvU32)(16 * p->stride), (NvU32)p->bytes, (NvU32)bands,
+                      !mirror && pl == 1 && row + 1 == phases);
+        }
+    }
+    if (mirror)
+        copy_linear(c, dst->gpu, mirror->gpu, frameSize, true);
+    if (chan_submit(c)) return false;
+    if (!chan_wait_release(c, &copy->sem, seq)) {
+        dec_copy_close(copy);
+        return false;
+    }
+    return true;
+}
diff --git a/vendor/nvenc/src/dec_copy.h b/vendor/nvenc/src/dec_copy.h
new file mode 100644
index 0000000000000000000000000000000000000000..604d9f304318c74d8c41697ad22bdc4c0feca5ac
--- /dev/null
+++ b/vendor/nvenc/src/dec_copy.h
@@ -0,0 +1,26 @@
+// Copies Ampere AV1/VP9 KBL pictures into pitch-linear device memory.
+#pragma once
+#include "channel.h"
+#include <CoreFoundation/CoreFoundation.h>
+
+typedef struct {
+    Chan chan;
+    RmMem scratch, sem, zero, prefix, readback;
+    NvU32 seq;
+    struct { uint32_t sid; uint64_t generation; CFDataRef bytes; } header[8];
+    unsigned nextHeader;
+} DecCopy;
+
+typedef struct {
+    const RmMem *src;
+    size_t offset, stride, bytes, rows;    // destination plane, excluding padding
+} DecCopyPlane;
+
+bool dec_copy_open(DecCopy *copy, Rm *rm, size_t pitch, size_t rows);
+void dec_copy_close(DecCopy *copy);
+bool dec_picture_surfaces(DecCopy *copy, Rm *rm, size_t pitch, size_t rows,
+                          RmMem *y, size_t ybytes, RmMem *uv, size_t uvbytes,
+                          size_t count, bool zero);
+// Both writes and the final system-visible release have completed on success.
+bool dec_copy_picture(DecCopy *copy, size_t pitch, const DecCopyPlane planes[2], const RmMem *dst,
+                      size_t frameSize, size_t prefixSize, const RmMem *mirror);
diff --git a/vendor/nvenc/src/dec_surface.c b/vendor/nvenc/src/dec_surface.c
new file mode 100644
index 0000000000000000000000000000000000000000..5d61bdbefbcd11955589aaf676bfc68b3dd6b8db
--- /dev/null
+++ b/vendor/nvenc/src/dec_surface.c
@@ -0,0 +1,146 @@
+#include "../vt/nvencvt_surface.h"
+#include <IOSurface/IOSurface.h>
+#include <string.h>
+#include <unistd.h>
+
+// The standalone vendor library is built separately from the kext. These are the
+// v2 nvrm_surfshare_abi.h field layout and the checked whole-frame operation.
+enum { SURF_VRAM = 0xe2, SURF_DIRTY = 0xe3, VIDEO_FRAME = 0x20000000u };
+typedef struct {
+    uint32_t version, surfaceID, plane, hClient, hSrcClient, hSrcMemory, status, pad;
+    uint64_t size;
+} SurfaceShare;
+_Static_assert(sizeof(SurfaceShare) == 40, "surface share ABI");
+typedef struct { uint32_t seed, reserved; uint64_t generation; } FrameTag;
+_Static_assert(sizeof(FrameTag) == 16, "decoder publication tag");
+
+static bool valid_output(CVPixelBufferRef pb, unsigned bps, unsigned w, unsigned h)
+{
+    OSType pf = CVPixelBufferGetPixelFormatType(pb);
+    bool supported = (bps == 1 && (pf == kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange ||
+                                  pf == kCVPixelFormatType_420YpCbCr8BiPlanarFullRange)) ||
+                     (bps == 2 && (pf == kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange ||
+                                  pf == kCVPixelFormatType_420YpCbCr10BiPlanarFullRange));
+    return supported && w && h && CVPixelBufferGetPlaneCount(pb) == 2 &&
+        CVPixelBufferGetWidthOfPlane(pb, 0) == w && CVPixelBufferGetHeightOfPlane(pb, 0) == h &&
+        CVPixelBufferGetWidthOfPlane(pb, 1) == ((size_t)w + 1) / 2 && CVPixelBufferGetHeightOfPlane(pb, 1) == ((size_t)h + 1) / 2;
+}
+
+static uint64_t previous_frame(IOSurfaceRef s)
+{
+    FrameTag tag = {0};
+    CFTypeRef v = IOSurfaceCopyValue(s, CFSTR("NVMTLDecodedFrameV1"));
+    if (v && CFGetTypeID(v) == CFDataGetTypeID() && CFDataGetLength((CFDataRef)v) == sizeof tag)
+        memcpy(&tag, CFDataGetBytePtr((CFDataRef)v), sizeof tag);
+    if (v) {
+        CFRelease(v);
+        IOSurfaceRemoveValue(s, CFSTR("NVMTLDecodedFrameV1"));
+    }
+    return tag.seed == IOSurfaceGetSeed(s) && !tag.reserved ? tag.generation : 0;
+}
+
+static bool get_header(DecCopy *copy, IOSurfaceRef s, uint64_t gen, size_t n)
+{
+    if (!n) return true;
+    if (n > copy->prefix.size) return false;
+    for (unsigned i = 0; gen && i < 8; i++) {
+        if (copy->header[i].sid == IOSurfaceGetID(s) && copy->header[i].generation == gen &&
+            copy->header[i].bytes && (size_t)CFDataGetLength(copy->header[i].bytes) == n) {
+            memcpy(copy->prefix.cpu, CFDataGetBytePtr(copy->header[i].bytes), n);
+            return true;
+        }
+    }
+    const IOSurfaceLockOptions options = kIOSurfaceLockReadOnly | kIOSurfaceLockAvoidSync;
+    if (IOSurfaceLock(s, options, NULL) != kIOReturnSuccess) return false;
+    memcpy(copy->prefix.cpu, IOSurfaceGetBaseAddress(s), n);
+    return IOSurfaceUnlock(s, options, NULL) == kIOReturnSuccess;
+}
+
+static bool get_backing(Rm *rm, unsigned sid, unsigned plane, size_t n, SurfaceShare *e)
+{
+    *e = (SurfaceShare){ .version = 2, .surfaceID = sid, .plane = VIDEO_FRAME | plane,
+                         .hClient = rm->client, .status = UINT32_MAX, .size = n };
+    return !rm_esc(rm, rm->ctl, SURF_VRAM, e, sizeof *e) && !e->status && e->pad &&
+           e->hSrcClient && e->hSrcMemory && e->size >= n && !(e->size & 4095);
+}
+
+bool nvdec_output_vram(DecCopy *copy, CVPixelBufferRef pb, size_t pitch,
+                       const RmMem *y, const RmMem *uv, unsigned bps, unsigned w, unsigned h)
+{
+    IOSurfaceRef s = CVPixelBufferGetIOSurface(pb);
+    if (!s) return false;
+    uint64_t prev = previous_frame(s);
+    Rm *rm = copy->chan.rm;
+    if (!rm || !valid_output(pb, bps, w, h) || IOSurfaceGetPlaneCount(s) != 2) return false;
+    size_t n = IOSurfaceGetAllocSize(s);
+    uintptr_t base = (uintptr_t)IOSurfaceGetBaseAddress(s);
+    uintptr_t py = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, 0), puv = (uintptr_t)IOSurfaceGetBaseAddressOfPlane(s, 1);
+    if (!base || py < base || puv < py || puv - base >= n || !n || n > UINT32_MAX) return false;
+    size_t yoff = py - base, uvoff = puv - base;
+    size_t ys = IOSurfaceGetBytesPerRowOfPlane(s, 0), uvs = IOSurfaceGetBytesPerRowOfPlane(s, 1);
+    size_t ybytes = (size_t)w * bps, cbytes = (size_t)((w + 1ULL) & ~1ULL) * bps;
+    size_t crows = ((size_t)h + 1) / 2;
+    if (ys != CVPixelBufferGetBytesPerRowOfPlane(pb, 0) || uvs != CVPixelBufferGetBytesPerRowOfPlane(pb, 1) ||
+        ys < ybytes || uvs < cbytes || h > (uvoff - yoff) / ys || crows > (n - uvoff) / uvs ||
+        !get_header(copy, s, prev, yoff)) return false;
+
+    const unsigned sid = IOSurfaceGetID(s);
+    SurfaceShare e[2];
+    if (!get_backing(rm, sid, 0, n, &e[0]) || !get_backing(rm, sid, 1, n, &e[1])) return false;
+    bool same = e[0].pad == e[1].pad;
+    RmMem out[2] = {0};
+    if (rm_mem_dup(rm, out, e[0].hSrcClient, e[0].hSrcMemory, e[0].size)) return false;
+    bool copied = false;
+    if (same || !rm_mem_dup(rm, out + 1, e[1].hSrcClient, e[1].hSrcMemory, e[1].size)) {
+        const DecCopyPlane planes[2] = {{y, yoff, ys, ybytes, h}, {uv, uvoff, uvs, cbytes, crows}};
+        copied = dec_copy_picture(copy, pitch, planes, out, n, yoff, same ? NULL : out + 1);
+    }
+    bool published = false;
+    if (copied) {
+        SurfaceShare dirty = { .version = 2, .surfaceID = sid, .plane = VIDEO_FRAME, .hClient = rm->client,
+                               .status = UINT32_MAX, .size = ((uint64_t)e[1].pad << 32) | e[0].pad };
+        published = !rm_esc(rm, rm->ctl, SURF_DIRTY, &dirty, sizeof dirty) && !dirty.status;
+    }
+    rm_mem_free(rm, out + 1); rm_mem_free(rm, out);
+    if (!published) return false;
+    static uint32_t sequence;
+    uint32_t next = __atomic_add_fetch(&sequence, 1, __ATOMIC_RELAXED);
+    if (!next) next = __atomic_add_fetch(&sequence, 1, __ATOMIC_RELAXED);
+    FrameTag tag = { IOSurfaceGetSeed(s), 0, ((uint64_t)(uint32_t)getpid() << 32) | next };
+    CFDataRef data = CFDataCreate(NULL, (const UInt8 *)&tag, sizeof tag);
+    if (!data) return false;
+    IOSurfaceSetValue(s, CFSTR("NVMTLDecodedFrameV1"), data);
+    CFRelease(data);
+    if (yoff) {
+        unsigned i = copy->nextHeader++ % 8;
+        if (copy->header[i].bytes) CFRelease(copy->header[i].bytes);
+        copy->header[i].sid = sid; copy->header[i].generation = tag.generation;
+        copy->header[i].bytes = CFDataCreate(NULL, copy->prefix.cpu, yoff);
+    }
+    return true;
+}
+
+bool nvdec_output_readback(DecCopy *copy, CVPixelBufferRef pb, size_t pitch,
+                           const RmMem *y, const RmMem *uv, unsigned bps, unsigned w, unsigned h)
+{
+    if (!copy->chan.rm || !valid_output(pb, bps, w, h)) return false;
+    unsigned char *d[2] = { CVPixelBufferGetBaseAddressOfPlane(pb, 0), CVPixelBufferGetBaseAddressOfPlane(pb, 1) };
+    size_t stride[2] = { CVPixelBufferGetBytesPerRowOfPlane(pb, 0), CVPixelBufferGetBytesPerRowOfPlane(pb, 1) };
+    size_t bytes = (size_t)w * bps, cb = ((w + 1ULL) & ~1ULL) * bps, ch = ((size_t)h + 1) / 2;
+    if (!d[0] || !d[1] || stride[0] < bytes || stride[1] < cb || bytes > pitch || cb > pitch ||
+        pitch > 32768 || h > 16384) return false;
+    size_t need = pitch * (h + ch);
+    Rm *rm = copy->chan.rm;
+    if (copy->readback.size < need) {
+        rm_mem_free(rm, &copy->readback);
+        if (rm_mem_alloc(rm, &copy->readback, need, 4096, true, true, true)) {
+            rm_mem_free(rm, &copy->readback); return false;
+        }
+    }
+    DecCopyPlane p[2] = {{y, 0, pitch, bytes, h}, {uv, pitch * h, pitch, cb, ch}};
+    if (!dec_copy_picture(copy, pitch, p, &copy->readback, 0, 0, NULL)) return false;
+    for (unsigned i = 0; i < 2; i++)
+        for (size_t row = 0; row < p[i].rows; row++)
+            memcpy(d[i] + row * stride[i], (const uint8_t *)copy->readback.cpu + p[i].offset + row * pitch, p[i].bytes);
+    return true;
+}
