+#include <cassert>
+#include "nvrm-fb-safety.h"
+enum { NVKMS_KAPI_LAYER_PRIMARY_IDX = 0, NV_TRUE = 1, NvKmsSurfaceMemoryFormatX2B10G10R10 = 5 };
+struct NvKmsKapiLayerRequestedConfig {
+    struct { bool cscChanged = false, surfaceChanged = false; } flags;
+    struct { void *surface = nullptr; struct { int m[3][4] = {}; } csc; } config;
+};
+struct Config {
+    struct { struct { bool bActive = true; } modeSetConfig;
+             NvKmsKapiLayerRequestedConfig layerRequestedConfig[1]; } headRequestedConfig[1];
+};
+struct Head {
+    bool fScan30 = true, fHdrActive = false, fSurActive = false, fProxy = false;
+    unsigned long long fPrimaryFormats = 1ULL << NvKmsSurfaceMemoryFormatX2B10G10R10;
+    unsigned fHead = 0;
+    int gVibrance = 0;
+    void *fFrontL10r = nullptr;
+    bool canScanL10r() const GATE
+    void submit(Config *cfg, bool frame, bool l10r, bool accepted) {
+        PREPARE
+        if (accepted) { PUBLISH }
+    }
+};
+struct Probe {
+    using NvBool = bool;
+    enum { NV_TRUE = 1, NV_FALSE = 0, NV_KMS_FLIP_RESULT_SUCCESS = 0 };
+    struct Reply { int flipResult = 0; };
+    bool testOK = true, front = false;
+    int testResult = 0, tests = 0, commits = 0;
+    static void nvu_zero(Reply *p, unsigned) { *p = {}; }
+    bool submitConfig(Config *, Reply *p, bool commit, bool, bool, bool, bool) {
+        if (commit) { commits++; return true; }
+        tests++; p->flipResult = testResult; return testOK;
+    }
+    bool flip(bool l10r) {
+        bool fFrontL10r = front;
+        Config c, *cfg = &c;
+        Reply r, *rep = &r;
+        PREFLIGHT
+        return ok;
+    }
+};
+static void checkMatrix(const NvKmsKapiLayerRequestedConfig &layer, int vibrance, bool swapped)
+{
+    int expected[3][3];
+    nvrmSaturationMatrix(vibrance, expected);
+    // A red, green or blue ramp has the same output as the corresponding
+    // correctly ordered source passed through the existing vibrance matrix.
+    for (int row = 0; row < 3; row++) {
+        for (int channel = 0; channel < 3; channel++)
+            assert(layer.config.csc.m[row][swapped ? 2 - channel : channel] == expected[row][channel]);
+        assert(layer.config.csc.m[row][3] == 0);
+    }
+    assert(layer.flags.cscChanged);
+}
+int main()
+{
+    Probe probe;
+    probe.testOK = false; assert(!probe.flip(true) && probe.commits == 0);
+    probe.testOK = true; probe.testResult = 1; assert(!probe.flip(true) && probe.commits == 0);
+    probe.testResult = 0; assert(probe.flip(true) && probe.tests == 3 && probe.commits == 1);
+    probe.front = true; assert(probe.flip(true) && probe.tests == 3 && probe.commits == 2);
+    probe.front = false; assert(probe.flip(false) && probe.tests == 3 && probe.commits == 3);
+    Head head; int packed, bgra;
+    assert(head.canScanL10r());
+    for (auto field : { &Head::fHdrActive, &Head::fSurActive, &Head::fProxy }) {
+        head.*field = true; assert(!head.canScanL10r()); head.*field = false;
+    }
+    head.fScan30 = false; assert(head.canScanL10r()); // 10-bit input to an 8-bit SDR output
+    head.fPrimaryFormats = 0; assert(!head.canScanL10r());
+    Config cfg;
+    auto &primary = cfg.headRequestedConfig[0].layerRequestedConfig[0];
+    primary.config.surface = &packed; primary.flags.surfaceChanged = true;
+    head.submit(&cfg, true, true, false); checkMatrix(primary, 0, true);
+    assert(head.fFrontL10r == nullptr);
+    head.submit(&cfg, true, true, true); assert(head.fFrontL10r == &packed);
+    // A mode change retaining the same front and a live vibrance update.
+    head.gVibrance = 65;
+    head.submit(&cfg, false, false, true); checkMatrix(primary, 65, true);
+    primary.flags.surfaceChanged = false; primary.config.surface = nullptr;
+    head.submit(&cfg, false, false, true); checkMatrix(primary, 65, true);
+    // An unrelated cursor update does not alter the primary CSC.
+    primary.flags.cscChanged = false;
+    head.submit(&cfg, false, false, true); assert(!primary.flags.cscChanged && head.fFrontL10r == &packed);
+    primary.flags.surfaceChanged = true; primary.config.surface = &bgra;
+    head.submit(&cfg, true, false, true); checkMatrix(primary, 65, false);
+    assert(head.fFrontL10r == nullptr);
+    primary.flags.cscChanged = false;
+    head.submit(&cfg, true, false, true); assert(!primary.flags.cscChanged);
+}
+'''
+fixture = ('#include <initializer_list>\n' + fixture.replace('GATE', gate).replace('PREPARE', prepare)
+           .replace('PUBLISH', publish).replace('PREFLIGHT', preflight))
+with tempfile.TemporaryDirectory() as tmp:
+    directory = pathlib.Path(tmp)
+    cpp = directory / 'scanout.cpp'
+    cpp.write_text(fixture)
+    binary = directory / 'scanout'
+    subprocess.run(['clang++', '-std=c++17', '-Wall', '-Werror',
+                    '-I' + str(root / 'kexts/NVRMFB/fb'), str(cpp), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
+print('PASS: scanout format gates, RGB order, vibrance, retained front, rejected flip and return to BGRA')
diff --git a/tools/test_nocopy_owner.m b/tools/test_nocopy_owner.m
new file mode 100644
index 0000000000000000000000000000000000000000..4747ade4cc33bfda082549e1344114a0aff41fd0
--- /dev/null
+++ b/tools/test_nocopy_owner.m
@@ -0,0 +1,213 @@
+// Isolated hardware check. Pass the NVMTLDriver executable to test.
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <IOKit/IOKitLib.h>
+#import <objc/message.h>
+#import <objc/runtime.h>
+#include <assert.h>
+#include <dlfcn.h>
+#include <mach/mach_vm.h>
+#include <sys/mman.h>
+#include "nvmtl_vk.h"
+
+static void observed(void *context) { ++*(unsigned *)context; }
+
+static nvk_buffer *buffer_backing(id<MTLBuffer> buffer, const char *name) {
+    Ivar field = class_getInstanceVariable(buffer.class, name);
+    assert(field);
+    return (nvk_buffer *)((char *)(__bridge void *)buffer + ivar_getOffset(field));
+}
+
+static void *borrowed_mapping(size_t length) {
+    void *address = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+    assert(address != MAP_FAILED);
+    return address;
+}
+
+static id<MTLBuffer> import_borrowed(id<MTLDevice> device, void *address, size_t size, BOOL expectAlias) {
+    uint64_t start = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    id<MTLBuffer> buffer = [device newBufferWithBytesNoCopy:address length:size
+        options:MTLResourceStorageModeShared deallocator:nil];
+    double elapsedMS = (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - start) / 1e6;
+    assert(buffer && buffer.contents == address);
+    assert((buffer_backing(buffer, "_b")->host_origin == NVMTL_HOST_NOCOPY_ALIAS) == expectAlias);
+    printf("PASS: %zu-byte borrow (%s), import %.3f ms\n", size, expectAlias ? "alias" : "fallback", elapsedMS);
+    return buffer;
+}
+
+static void check_large_alias(id<MTLDevice> device, id<MTLBuffer> buffer) {
+    const NSUInteger page = getpagesize();
+    const NSUInteger last = buffer.length - page;
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    id<MTLBuffer> output = [device newBufferWithLength:page * 2 options:MTLResourceStorageModeShared];
+    uint8_t *bytes = buffer.contents;
+    memset(bytes, 0x37, page);
+    memset(bytes + last, 0x61, page);
+    id<MTLCommandBuffer> command = [queue commandBuffer];
+    id<MTLBlitCommandEncoder> blit = [command blitCommandEncoder];
+    [blit copyFromBuffer:buffer sourceOffset:0 toBuffer:output destinationOffset:0 size:page];
+    [blit copyFromBuffer:buffer sourceOffset:last toBuffer:output destinationOffset:page size:page];
+    [blit fillBuffer:buffer range:NSMakeRange(0, page) value:0x59];
+    [blit fillBuffer:buffer range:NSMakeRange(last, page) value:0x63];
+    [blit endEncoding]; [command commit]; [command waitUntilCompleted]; assert(!command.error);
+    const uint8_t *copied = output.contents;
+    for (NSUInteger i = 0; i < page; i++) {
+        assert(copied[i] == 0x37 && copied[page + i] == 0x61);
+        assert(bytes[i] == 0x59 && bytes[last + i] == 0x63);
+    }
+}
+
+static void wait_for_alias_budget(id<MTLDevice> device, void *address) {
+    uint64_t end = clock_gettime_nsec_np(CLOCK_UPTIME_RAW) + 5 * NSEC_PER_SEC;
+    do {
+        @autoreleasepool {
+            id<MTLBuffer> probe = [device newBufferWithBytesNoCopy:address length:getpagesize()
+                options:MTLResourceStorageModeShared deallocator:nil];
+            assert(probe);
+            if (buffer_backing(probe, "_b")->host_origin == NVMTL_HOST_NOCOPY_ALIAS) return;
+        }
+        usleep(1000);
+    } while (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) < end);
+    assert(!"alias quota was not reclaimed");
+}
+
+static void check_alias_limit(id<MTLDevice> device) {
+    const size_t cap = NVMTL_WS_NOCOPY_ALIAS_BYTES;
+    const size_t page = getpagesize();
+    void *oversized = borrowed_mapping(cap + page);
+    @autoreleasepool {
+        (void)import_borrowed(device, oversized, cap + page, NO);
+    }
+    assert(!munmap(oversized, cap + page));
+
+    void *full = borrowed_mapping(cap);
+    void *small = borrowed_mapping(page);
+    uint64_t releaseStart;
+    @autoreleasepool {
+        __attribute__((objc_precise_lifetime)) id<MTLBuffer> exact = import_borrowed(device, full, cap, YES);
+        check_large_alias(device, exact);
+        (void)import_borrowed(device, small, page, NO);
+        releaseStart = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    }
+    uint64_t wrapperReturned = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+    assert(!munmap(full, cap));
+    wait_for_alias_budget(device, small);
+    double wrapperMS = (wrapperReturned - releaseStart) / 1e6;
+    double quotaMS = (clock_gettime_nsec_np(CLOCK_UPTIME_RAW) - releaseStart) / 1e6;
+    printf("PASS: 512 MiB wrapper release %.3f ms, alias quota reusable within %.3f ms\n", wrapperMS, quotaMS);
+    assert(!munmap(small, page));
+}
+
+static void check_alias_pressure(id<MTLDevice> device) {
+    const size_t half = NVMTL_WS_NOCOPY_ALIAS_BYTES / 2;
+    const size_t page = getpagesize();
+    void *first = borrowed_mapping(half), *second = borrowed_mapping(half), *over = borrowed_mapping(page);
+    @autoreleasepool {
+        __attribute__((objc_precise_lifetime)) id<MTLBuffer> one = import_borrowed(device, first, half, YES);
+        __attribute__((objc_precise_lifetime)) id<MTLBuffer> two = import_borrowed(device, second, half, YES);
+        (void)import_borrowed(device, over, page, NO);
+    }
+    assert(!munmap(first, half) && !munmap(second, half));
+    wait_for_alias_budget(device, over);
+    assert(!munmap(over, page));
+}
+
+int main(int argc, char **argv) { @autoreleasepool {
+    const BOOL aliases = argc == 3 && !strcmp(argv[2], "--aliases");
+    const BOOL limit = argc == 3 && !strcmp(argv[2], "--alias-limit");
+    const BOOL pressure = argc == 3 && !strcmp(argv[2], "--alias-pressure");
+    assert(argc == 2 || aliases || limit || pressure);
+    const BOOL enableAliases = aliases || limit || pressure;
+    assert(!setenv("NVMTL_WS_NOCOPY_ALIAS", enableAliases ? "1" : "0", 1));
+    if (enableAliases) assert(!setenv("NVMTL_WS_DEFER_BUFFER_FREE", "1", 1));
+    void *lib = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
+    assert(lib);
+    Class deviceClass = NSClassFromString(@"NVMTLDevice");
+    char actual[PATH_MAX], expected[PATH_MAX];
+    assert(deviceClass && realpath(class_getImageName(deviceClass), actual) &&
+           realpath(argv[1], expected) && !strcmp(actual, expected));
+    io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("NVAccel"));
+    assert(service);
+    id<MTLDevice> device = ((id (*)(id, SEL, mach_port_t))objc_msgSend)(
+        [deviceClass alloc], NSSelectorFromString(@"initWithAcceleratorPort:"), service);
+    IOObjectRelease(service); assert(device);
+#define LOAD(name) __typeof__(&nvmtl_vk_##name) name = dlsym(lib, "nvmtl_vk_" #name); assert(name)
+    LOAD(queue_create); LOAD(queue_destroy); LOAD(buffer_create); LOAD(buffer_destroy);
+    LOAD(cmd_begin); LOAD(cmd_fill_buffer); LOAD(inflight_new); LOAD(inflight_free);
+    LOAD(submit_begin_at); LOAD(submit_finish_observed);
+    nvk_queue raw = {0}; nvk_buffer scratch = {0};
+    assert(!queue_create(&raw) && !buffer_create(4096, 1, &scratch));
+    if (limit) check_alias_limit(device);
+    if (pressure) check_alias_pressure(device);
+    const unsigned smallCases = limit || pressure ? 0 : (aliases ? 5 : 4);
+    for (unsigned arm = 0; arm < smallCases; arm++) {
+        const BOOL managed = arm == 1, fallback = arm == 2, owned = arm < 3;
+        const BOOL alias = aliases && !owned;
+        const NSUInteger length = (arm == 4 ? 20 : 64) * 1024;
+        void *allocation = NULL;
+        if (owned) assert(!posix_memalign(&allocation, 65536, 131072));
+        else allocation = borrowed_mapping(length);
+        uint8_t *ptr = (uint8_t *)allocation + fallback;
+        memset(ptr, 0x11, length);
+        dispatch_semaphore_t returned = dispatch_semaphore_create(0);
+        __block unsigned callbacks = 0;
+        nvk_cmdbuf marker = {0};
+        nvmtl_inflight *fence = inflight_new(); assert(fence);
+        @autoreleasepool {
+            void (^release)(void *, NSUInteger) = ^(void *p, NSUInteger n) {
+                assert(p == ptr && n == length && ++callbacks == 1);
+                dispatch_semaphore_signal(returned);
+            };
+            id<MTLBuffer> source = [device newBufferWithBytesNoCopy:ptr length:length
+                options:managed ? MTLResourceStorageModeManaged : MTLResourceStorageModeShared
+                deallocator:owned ? release : nil];
+            assert(source && source.contents == ptr);
+            nvk_buffer *backing = buffer_backing(source, managed ? "_shadow" : "_b");
+            assert(!!backing->imported == !fallback);
+            if (!fallback) {
+                unsigned origin = managed ? NVMTL_HOST_NOCOPY_MANAGED : NVMTL_HOST_NOCOPY_DIRECT;
+                if (alias) origin = NVMTL_HOST_NOCOPY_ALIAS;
+                assert(backing->host_origin == origin && backing->host_import_id);
+            }
+            id<MTLCommandQueue> q = [device newCommandQueue];
+            id<MTLBuffer> dst = [device newBufferWithLength:length options:MTLResourceStorageModeShared];
+            memset(ptr, 0x37, length);
+            if (managed) [source didModifyRange:NSMakeRange(0, length)];
+            id<MTLCommandBuffer> cb = [q commandBuffer];
+            id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+            [blit copyFromBuffer:source sourceOffset:0 toBuffer:dst destinationOffset:0 size:length];
+            [blit fillBuffer:source range:NSMakeRange(0, length) value:0x59];
+            if (managed) [blit synchronizeResource:source];
+            [blit endEncoding]; [cb commit]; [cb waitUntilCompleted]; assert(!cb.error);
+            const uint8_t *copied = dst.contents;
+            for (NSUInteger i=0; i<length; i++) {
+                assert(copied[i]==0x37);
+                assert(ptr[i]==0x59);
+            }
+            // Hold a real submission's fence observation while the last Metal reference is released.
+            assert(!cmd_begin(&raw, &marker) && !cmd_fill_buffer(&marker, &scratch, 0, 4096, 0x21));
+            assert(!submit_begin_at(&marker, fence, "owned host lifetime probe"));
+        }
+        if (!fallback) assert(dispatch_semaphore_wait(returned, DISPATCH_TIME_NOW) != 0);
+        if (alias) {
+            // The caller can release and reuse the original virtual address while the driver owns the alias.
+            assert(!munmap(ptr, length));
+            mach_vm_address_t replacement = (uintptr_t)ptr;
+            assert(mach_vm_allocate(mach_task_self(), &replacement, length, VM_FLAGS_FIXED) == KERN_SUCCESS);
+            memset(ptr, 0xa8, length);
+        }
+        unsigned fences=0;
+        assert(!submit_finish_observed(fence, observed, &fences) && fences==1);
+        inflight_free(fence);
+        if (owned) assert(!dispatch_semaphore_wait(returned,dispatch_time(DISPATCH_TIME_NOW,5*NSEC_PER_SEC)));
+        assert(callbacks==(unsigned)owned);
+        if (alias) for (NSUInteger i=0; i<length; i++) assert(ptr[i] == 0xa8);
+        if (owned) free(allocation);
+        else assert(!munmap(ptr, length));
+        printf("PASS: %s (%lu bytes), CPU and GPU visibility, caller ownership and release\n",
+               managed ? "managed host shadow" : fallback ? "unaligned copy fallback" :
+               owned ? "shared host import" : alias ? "caller-managed shared alias" : "caller-managed direct import",
+               (unsigned long)length);
+    }
+    buffer_destroy(&scratch); queue_destroy(&raw);
+} }
diff --git a/tools/test_nvdec_vram_copy.c b/tools/test_nvdec_vram_copy.c
new file mode 100644
index 0000000000000000000000000000000000000000..027c8228713c90e1cf53b8612e111587956a23c9
--- /dev/null
+++ b/tools/test_nvdec_vram_copy.c
@@ -0,0 +1,68 @@
+// GA104 hardware test. Build with the vendor/nvenc/src includes and RM headers used
+// by build_nvencvt.sh, linking dec_copy.c, blocklinear.c, channel.c and rm.c.
+#include "dec_copy.h"
+#include "blocklinear.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint8_t pixel(int plane, size_t x, size_t y)
+{
+    return (uint8_t)(plane * 67 + x * 13 + y * 91 + 5);
+}
+
+static bool check_frame(Rm *rm, size_t width, size_t height, unsigned bytesPerSample)
+{
+    size_t chromaWidth = ((width + 1) & ~(size_t)1) * bytesPerSample;
+    size_t pitch = (chromaWidth + 63) & ~(size_t)63;
+    size_t stride = pitch + 64, chromaRows = (height + 1) / 2;
+    size_t first = 128, second = first + stride * height + 128;
+    size_t size = second + stride * chromaRows + 48;
+    RmMem src[2] = {0}, out[2] = {0};
+    DecCopy copy;
+    if (!dec_copy_open(&copy, rm, pitch, height)) return false;
+    uint8_t *expected = calloc(1, size);
+    bool match = false;
+    if (!expected) goto done;
+    DecCopyPlane planes[2] = {
+        {&src[0], first, stride, width * bytesPerSample, height},
+        {&src[1], second, stride, chromaWidth, chromaRows}
+    };
+    for (size_t i = 0; i < first; i++) expected[i] = (uint8_t)(0xe0 + i);
+    memcpy(copy.prefix.cpu, expected, first);
+    for (int plane = 0; plane < 2; plane++) {
+        const DecCopyPlane *p = &planes[plane];
+        size_t n = nvenc_in_plane_size(pitch, p->rows);
+        if (rm_mem_alloc(rm, &src[plane], n, 4096, false, true, true) ||
+            rm_mem_alloc(rm, &out[plane], size, 4096, false, true, true)) goto done;
+        uint8_t *tiled = calloc(1, n);
+        if (!tiled) goto done;
+        for (size_t y = 0; y < p->rows; y++)
+            for (size_t x = 0; x < p->bytes; x++) {
+                uint8_t v = pixel(plane, x, y);
+                tiled[nvenc_in_offset(x, y, pitch)] = v;
+                expected[p->offset + y * stride + x] = v;
+            }
+        memcpy(src[plane].cpu, tiled, n);
+        free(tiled);
+        memset(out[plane].cpu, plane ? 0xa5 : 0x5a, size);
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    match = dec_copy_picture(&copy, pitch, planes, out, size, first, out + 1) &&
+            !memcmp(expected, out[0].cpu, size) && !memcmp(expected, out[1].cpu, size);
+done:
+    dec_copy_close(&copy);
+    for (int i = 0; i < 2; i++) { rm_mem_free(rm, &out[i]); rm_mem_free(rm, &src[i]); }
+    free(expected);
+    printf("%zux%zu, %u byte samples: %s\n", width, height, bytesPerSample, match ? "pass" : "FAIL");
+    return match;
+}
+
+int main(void)
+{
+    Rm rm = {0};
+    bool success = !rm_open(&rm) && !rm_va_init(&rm) &&
+        check_frame(&rm, 257, 129, 1) && check_frame(&rm, 1919, 1079, 1) && check_frame(&rm, 257, 129, 2);
+    rm_close(&rm);
+    return success ? 0 : 1;
+}
diff --git a/tools/test_pixel_sampler_log.py b/tools/test_pixel_sampler_log.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ddf61c63a91d98c44eb04ec67d418dc2d276b98
--- /dev/null
+++ b/tools/test_pixel_sampler_log.py
@@ -0,0 +1,113 @@
+#!/usr/bin/env python3
+"""Compare eager and rate-limited sampler diagnostics using the production logger on the host."""
+import re
+import subprocess
+import tempfile
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[1]
+plugin = root / "plugin"
+source = (plugin / "NVMTLDevice.m").read_text()
+
+
+def section(start, end):
+    return source[source.index(start):source.index(end, source.index(start))]
+
+
+sampler = section("- (id<MTLSamplerState>)newSamplerStateWithDescriptor:", "- (id<MTLComputePipelineState>)")
+assert "nvlog_pixel_sampler(s->_pixelState)" in sampler
+limiter = section("#define NVLOG_SITES", "const char *nvmtl_log_path(void)")
+logger = section("static void nvlog_line(const char *t);", "#define NVMTL_OOM_STREAK")
+fixture = r"""
+#import <Foundation/Foundation.h>
+#include <assert.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <syslog.h>
+#include <time.h>
+#include <unistd.h>
+#include "nvmtl_log_failure.h"
+static atomic_uint descriptions, notices, errors;
+static const char *logPath;
+static int optIn;
+static const char *nvmtl_log_path(void) { return logPath; }
+static int nvmtl_process_env_on(void) { return optIn; }
+static void capture_syslog(int priority, const char *fmt, ...) {
+    if (priority == LOG_ERR) ++errors;
+    else { assert(priority == LOG_NOTICE); ++notices; }
+}
+#define syslog capture_syslog
+""" + limiter + logger + r"""
+@interface CountedState : NSObject
+@property(nonatomic, copy) NSDictionary *fields;
+@end
+@implementation CountedState
+- (NSString *)description {
+    ++descriptions;
+    return self.fields.description;
+}
+@end
+
+int main(int argc, char **argv) { @autoreleasepool {
+    assert(argc == 5);
+    logPath = argv[1];
+    optIn = atoi(argv[2]);
+    const BOOL eager = atoi(argv[3]), full = atoi(argv[4]);
+    CountedState *state = [CountedState new];
+    state.fields = @{@"coordinates": @"Pixel", @"min_filter": @"Linear", @"max_anisotropy": @1,
+                     @"lod_max_clamp": @(FLT_MAX), @"address_mode_s": @"ClampToZero"};
+    static char sites[NVLOG_SITES];
+    if (full) {
+        // A saturated site table preserves every message.
+        uint64_t repeat;
+        for (unsigned i = 0; i < NVLOG_SITES; i++) nvlog_dropped(&sites[i], &repeat);
+    }
