+    } else assert(r->plane == (NVRM_SS_PLANE_GPU_MARK | (r->surfaceID && expects_pending ? 1u : 0u)));
+    if (failed) return kIOReturnNotAttached;
+    if (short_reply) { *len = sizeof *r - 1; return KERN_SUCCESS; }
