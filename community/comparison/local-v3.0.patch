+    assert(!nvmtl_vk_surface_dirty_try(17, 2) && last_call == g_ws_remark_connection);
+    assert(nvmtl_vk_surface_dirty_try(17, 16) == -1);
+    pthread_mutex_unlock(&g_ws_mark_lock);
+    pthread_mutex_lock(&g_ws_remark_lock);
